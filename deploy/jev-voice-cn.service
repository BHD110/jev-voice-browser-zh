[Unit]
Description=Jev Chinese voice browser
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hxy/apps/jev-voice-cn
ExecStart=/usr/bin/node src/server.js --headless --host 127.0.0.1 --port 5024
Environment=NODE_ENV=production
Environment=VOICE_BROWSER_MAX_SESSIONS=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
